# Секрет Auth.js — сгенерировать: openssl rand -base64 32
AUTH_SECRET="замените-на-результат-openssl-rand--base64-32"

# Домен для Caddy (prod). Для локального запуска — localhost
CADDY_DOMAIN="localhost"

# Файловое хранилище: S3 (MinIO). Без этих переменных файлы пишутся
# на локальный диск uploads/ (fallback для локальной разработки).
S3_ENDPOINT="http://192.168.0.33:9000"
S3_BUCKET="pero-crm"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="замените-на-пароль-minio"
