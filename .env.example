# Секрет Auth.js — сгенерировать: openssl rand -base64 32
AUTH_SECRET="замените-на-результат-openssl-rand--base64-32"

# Домен для Caddy (prod). Для локального запуска — localhost
CADDY_DOMAIN="localhost"

# Локальная разработка: явный режим local, пустые S3-поля допустимы.
# Server compose задаёт s3: endpoint/bucket/credentials должны быть заполнены
# в приватном окружении deployment; неполная настройка не включает диск.
CRM_FILE_STORAGE="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# КП и договоры: только точное значение 1 включает раздел; по умолчанию выключен.
PERO_KP_ENABLED=0

# Outbox worker: включать только в проверенном runtime после проверки изоляции.
DOMAIN_EVENT_WORKER_ENABLED=false
DOMAIN_EVENT_WORKER_INTERVAL_MS=15000
DOMAIN_EVENT_WORKER_BATCH_SIZE=50
DOMAIN_EVENT_LEASE_MS=120000
DOMAIN_EVENT_HEARTBEAT_MS=30000
DOMAIN_EVENT_DELIVERY_TIMEOUT_MS=90000
DOMAIN_EVENT_BACKOFF_BASE_MS=30000
DOMAIN_EVENT_BACKOFF_MAX_MS=900000
DOMAIN_EVENT_MAX_ATTEMPTS=12
# Проверенный ID существующей карточки «Временный»; сервис сам её не создаёт.
PERO_KP_TEMP_CLIENT_ID=""
