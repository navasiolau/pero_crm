{
  "name": "@pero/telegram-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram-бот PERO CRM — изолированный сервис (LXC tgbot), long polling + REST /api/v1/bot",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test test/*.test.mjs",
