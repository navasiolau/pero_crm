// PERO CRM v2 — схема данных (Фаза 1: каркас)
// Полная доменная модель — см. §8 плана, добавляется в следующих фазах.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DIRECTOR
  MANAGER
  ENGINEER
  WORKER
  MOUNTER
  ACCOUNTANT
}

enum PayScheme {
  PIECE
  PERCENT_PROJECT
  PERCENT_TURNOVER
  NONE
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  name            String // ФИО
  position        String? // должность (столяр, монтажник, менеджер проектов…)
  phone           String?
  telegram        String? // @username
  passwordHash    String
  role            Role
  payScheme       PayScheme      @default(NONE)
  payPercent      Decimal?       @db.Decimal(5, 2)
  active          Boolean        @default(true)
  legacyId        String?
  legacyTable     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  managedProjects Project[]      @relation("ProjectManager")
  engineeredProjects Project[]   @relation("ProjectEngineer")
  assignedTasks   Task[]         @relation("TaskAssignee")
  notifications   Notification[]
  payrollEntries  PayrollEntry[]
  payouts         Payout[]
}

// ─── Проекты и клиенты (фаза 2, §6) ──────────────────────────────────────────

enum ProjectStage {
  LEAD // Лид
  ESTIMATE // Просчёт
  CONTRACT // Договор
  IN_WORK // В работе
  DONE // Завершён
  REFUSED // Отказ
  PAUSED // Пауза
  RECLAMATION // Рекламация
}

enum TaskStatus {
  DRAFT // Черновик (без исполнителя)
  NEW // Новая
  IN_PROGRESS // В работе
  DONE // Выполнена
}

enum FileCategory {
  PHOTO // фото
  DRAWING // чертёж
  QUOTE // КП
  MEASUREMENT // замер
  DOCUMENT // документ
  OTHER // прочее
}

enum CommunicationType {
  CALL // звонок
  EMAIL // письмо
  MESSENGER // мессенджер
  MEETING // встреча
  NOTE // заметка
}

model Client {
  id             String          @id @default(cuid())
  name           String // Имя (или название для юрлица, напр. «ООО Альфа»)
  lastName       String? // Фамилия
  middleName     String? // Отчество
  phone          String
  email          String?
  address        String?
  comment        String?
  legacyId       String?
  legacyTable    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  projects       Project[]
  communications Communication[]
}

model Project {
  id                     String       @id @default(cuid())
  number                 String       @unique // П-2026-001
  title                  String // изделие / краткое описание
  stage                  ProjectStage @default(LEAD)
  stageChangedAt         DateTime     @default(now())
  expectedPrice          Decimal?     @db.Decimal(12, 2)
  currency               String       @default("BYN")
  description            String? // тех. блок (правит и инженер, §4)
  address                String?
  refusalReason          String?
  refusalComment         String?
  reclamationReason      String?
  reclamationDescription String?
  reclamationFault       String?
  managerId              String?
  manager                User?        @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  // Инженер-проектировщик: на него начисляется % от стоимости при
  // передаче проекта в производство (переход «В работе», §10)
  engineerId             String?
  engineer               User?        @relation("ProjectEngineer", fields: [engineerId], references: [id], onDelete: SetNull)
  clientId               String
  client                 Client       @relation(fields: [clientId], references: [id])
  createdById            String?
  legacyId               String?
  legacyTable            String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  stageHistory           ProjectStageHistory[]
  tasks                  Task[]
  works                  Work[]
  files                  File[]
  communications         Communication[]
  payments               Payment[]
  stockMovements         StockMovement[]
  projectMaterials       ProjectMaterial[]

  @@index([stage, stageChangedAt])
}

model ProjectStageHistory {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStage   ProjectStage?
  toStage     ProjectStage
  comment     String?
  changedById String?
  createdAt   DateTime     @default(now())

  @@index([projectId, createdAt])
}

// Задача (§9): статусы Черновик → Новая → В работе → Выполнена;
// зависимости DAG; оценка времени из истории + факт из TimeEntry.
model Task {
  id             String     @id @default(cuid())
  projectId      String
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  type           String? // "Замер" и др.; шаблоны — плагин Базиса
  status         TaskStatus @default(NEW)
  assigneeId     String?
  assignee       User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  workId         String?
  work           Work?      @relation(fields: [workId], references: [id], onDelete: SetNull)
  quantity       Decimal?   @db.Decimal(10, 2) // часть количества работы (работу можно делить между задачами)
  dueAt          DateTime?
  requiresPhoto  Boolean    @default(false) // при выполнении просим приложить файлы (§6.2)
  estimateMinutes Int? // оценка (среднее идентичных из истории / шаблон), правит менеджер
  executorShare  Decimal    @default(1) @db.Decimal(4, 3) // доля исполнителя в оплате работы
  doneAt         DateTime?
  doneById       String?
  createdById    String?
  legacyId       String?
  legacyTable    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  files          File[]
  timeEntries    TimeEntry[]
  dependencies   TaskDependency[]  @relation("TaskDependencies")
  dependents     TaskDependency[]  @relation("TaskDependents")
  payrollEntries PayrollEntry[]

  @@index([assigneeId, status])
}

// Зависимость задач (DAG, §9): задача блокируется,
// пока предшественники не выполнены.
model TaskDependency {
  taskId      String
  task        Task   @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   Task   @relation("TaskDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
}

// ─── Прайсы и работы (§9) ────────────────────────────────────────────────────

// Расценка из прайса. Изменения — в журнал (§5); цена фиксируется
// в работе на момент назначения (смена прайса не переписывает прошлое).
model PriceItem {
  id          String   @id @default(cuid())
  name        String
  unit        String // шт / м² / м.п. / компл / час
  price       Decimal  @db.Decimal(12, 2)
  category    String?
  active      Boolean  @default(true)
  legacyId    String?
  legacyTable String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  works       Work[]
}

// Работа в проекте: расценка × количество, цена — снимок на момент назначения.
model Work {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  priceItemId   String?
  priceItem     PriceItem? @relation(fields: [priceItemId], references: [id], onDelete: SetNull)
  title         String
  quantity      Decimal   @db.Decimal(10, 2)
  priceSnapshot Decimal   @db.Decimal(12, 2) // цена на момент назначения
  total         Decimal   @db.Decimal(12, 2) // priceSnapshot × quantity
  createdById   String?
  legacyId      String?
  legacyTable   String?
  createdAt     DateTime  @default(now())
  tasks         Task[]

  @@index([projectId])
}

// ─── Время по задачам (§9) ───────────────────────────────────────────────────

// Запись времени: таймер (старт-стоп на сервере, переживает перезаход)
// или ручной ввод. spentMinutes задачи = сумма minutes.
model TimeEntry {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  source      String // timer | manual
  startedAt   DateTime  @default(now())
  stoppedAt   DateTime?
  minutes     Int       @default(0)
  autoStopped Boolean   @default(false) // автостоп по таймауту 12 ч (§19)
  createdAt   DateTime  @default(now())

  @@index([userId, stoppedAt])
  @@index([taskId])
}

// ─── Начисления и выплаты (§10) ──────────────────────────────────────────────

// Начисление оплаты. Сдельно: расценка × количество × доля исполнителя,
// возникает при переходе задачи в «Выполнена». % от стоимости (инженер) —
// при переходе проекта «В работе». % от оборота — при закрытии месяца.
model PayrollEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  workId     String?
  // Проект необязателен: начисление «% от оборота» — на организацию целиком
  projectId  String?
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @default("BYN")
  scheme     String   @default("PIECE") // PIECE | PERCENT_PROJECT | PERCENT_TURNOVER
  month      String // YYYY-MM расчётного месяца
  comment    String?
  createdAt  DateTime @default(now())

  @@index([userId, month])
  @@index([projectId])
}

// Выплата зарплаты (§10): вносит администратор, история по месяцам.
// month — расчётный месяц, к которому относится выплата.
// kind: SALARY — обычная выплата по долгу за прошлые месяцы,
// ADVANCE — аванс текущим месяцем (потолок — только баланс организации;
// учитывается формулой долга автоматически: долг = начислено − ВСЕ выплаты).
model Payout {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2)
  month       String // YYYY-MM расчётного месяца
  kind        String   @default("SALARY") // SALARY | ADVANCE
  comment     String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([userId, month])
  @@index([month])
}

// Направление платежа (§11): приход от клиента / расход на проект
// (материалы, прочее — уменьшают маржу, см. экономику проекта).
enum PaymentDirection {
  INCOME
  EXPENSE
}

// Касса организации (§11): каждая в своей валюте. Баланс = сумма своих
// операций (приходы − расходы); операция проводится по кассе только
// в валюте кассы (конвертация фиксируется курсом в самой операции).
model CashAccount {
  id        String    @id @default(cuid())
  name      String
  currency  String    @default("BYN")
  comment   String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments  Payment[]
}

// Статья расходов (§8): справочник для расходов по проектам
// (Материалы, Логистика, Прочее…). ЗП в статьях нет — она считается
// из PayrollEntry (§10).
model ExpenseArticle {
  id        String    @id @default(cuid())
  name      String
  comment   String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments  Payment[]
}

// Платёж по проекту (§11): приход или расход в любой из 4 валют.
// Курс подтягивается с НБ РБ в момент внесения и СОХРАНЯЕТСЯ в записи
// (курс, дата курса, эквиваленты) — отдельного кэша курсов нет,
// историчность обеспечивается самими записями. Курс можно поправить вручную.
//   rate — BYN за 1 единицу валюты операции (как на сайте НБ РБ; 1 для BYN);
//   bynAmount — эквивалент в BYN (оборот для «% от оборота», баланс орг.);
//   projectAmount — эквивалент в валюте проекта (экономика проекта, маржа).
model Payment {
  id               String           @id @default(cuid())
  projectId        String
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  direction        PaymentDirection @default(INCOME)
  amount           Decimal          @db.Decimal(12, 2) // в валюте операции
  currency         String           @default("BYN")
  rate             Decimal          @default(1) @db.Decimal(14, 6) // BYN за ед. валюты (НБ РБ)
  rateDate         DateTime? // дата курса НБ РБ
  bynAmount        Decimal          @db.Decimal(12, 2) // эквивалент в BYN
  projectAmount    Decimal          @db.Decimal(12, 2) // эквивалент в валюте проекта
  cashAccountId    String?
  cashAccount      CashAccount?     @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)
  expenseArticleId String?
  expenseArticle   ExpenseArticle?  @relation(fields: [expenseArticleId], references: [id], onDelete: SetNull)
  paidAt           DateTime         @default(now())
  comment          String?
  createdById      String?
  createdAt        DateTime         @default(now())

  @@index([projectId])
  @@index([paidAt])
  @@index([cashAccountId])
}

// Настройки организации (§10): key-value, сейчас — payrollCurrency
// (единая валюта зарплаты, по умолчанию BYN; задаёт администратор).
model OrgSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Склад (§12, фаза 6) ────────────────────────────────────────────────
// Остатки не хранятся — вычисляются из StockMovement
// (остаток = Σ INCOME + Σ RETURN − Σ EXPENSE).

// Тип движения по складу: приход на склад / списание на проект /
// возврат с проекта обратно на склад.
enum StockMovementType {
  INCOME
  EXPENSE
  RETURN
}

// Категория номенклатуры (аналог legacy 1411 «Номенклатурные группы», плоско).
model MaterialCategory {
  id        String     @id @default(cuid())
  name      String
  comment   String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  materials Material[]
}

// Номенклатура (аналог legacy 1441 «Склад номенклатуры», MVP-набор полей).
// purchasePrice — учётная цена в BYN: подставляется в списание как снимок
// (в диалоге её можно поправить на конкретное движение).
model Material {
  id               String            @id @default(cuid())
  name             String
  sku              String? // артикул
  unit             String            @default("шт") // из MATERIAL_UNITS (src/lib/labels.ts)
  categoryId       String?
  category         MaterialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  purchasePrice    Decimal?          @db.Decimal(12, 2) // учётная цена, BYN
  minStock         Decimal?          @db.Decimal(12, 3) // подсветка низкого остатка
  active           Boolean           @default(true)
  comment          String?
  legacyId         String?
  legacyTable      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  movements        StockMovement[]
  projectMaterials ProjectMaterial[]
}

// Потребность проекта в материале (аналог legacy 1531 «Номенклатура в заказах»).
// Она же — простой резерв (§12): количество фиксируется за проектом
// БЕЗ проверки остатка (строки в будущем создаёт скриптом плагин
// «Базис-Мебельщик»). Нехватка вычисляется: debt = quantity − issuedQty,
// строка «в нехватке», если debt > 0 и остаток на складе < debt.
model ProjectMaterial {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialId  String
  material    Material        @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantity    Decimal         @db.Decimal(12, 3) // сколько нужно
  issuedQty   Decimal         @default(0) @db.Decimal(12, 3) // сколько уже выдано со склада
  comment     String?
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  movements   StockMovement[]

  @@unique([projectId, materialId]) // повторное добавление того же материала наращивает quantity
  @@index([materialId])
}

// Единый журнал движений (аналог legacy 1641 «Учёт движения»).
// EXPENSE/RETURN — всегда с проектом и ценой: totalByn идёт в экономику
// проекта (getProjectEconomics, строка «Материалы (склад)» в расходах).
model StockMovement {
  id                String            @id @default(cuid())
  materialId        String
  material          Material          @relation(fields: [materialId], references: [id], onDelete: Restrict)
  type              StockMovementType
  quantity          Decimal           @db.Decimal(12, 3)
  unitPrice         Decimal?          @db.Decimal(12, 2) // BYN/ед., снимок (обязателен для EXPENSE/RETURN)
  totalByn          Decimal?          @db.Decimal(12, 2) // quantity × unitPrice, снимок
  projectId         String?
  project           Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectMaterialId String?
  projectMaterial   ProjectMaterial?  @relation(fields: [projectMaterialId], references: [id], onDelete: SetNull)
  comment           String?
  createdById       String?
  createdAt         DateTime          @default(now())

  @@index([materialId])
  @@index([projectId])
  @@index([createdAt])
}

model File {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId       String?
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  category     FileCategory @default(OTHER)
  caption      String? // пояснение
  fileName     String // оригинальное имя
  storedName   String // имя на диске
  mimeType     String
  size         Int
  hasThumb     Boolean      @default(false)
  uploadedById String?
  legacyId     String?
  legacyTable  String?
  createdAt    DateTime     @default(now())

  @@index([projectId, category])
}

model Communication {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  type        CommunicationType
  text        String
  happenedAt  DateTime          @default(now())
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([projectId, happenedAt])
}

// ─── Уведомления (§6.1) ──────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // project.created, project.stageChanged, task.assigned, ...
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// Настройка типов уведомлений — только админ/директор/менеджер (§6.1);
// работник/монтажник/инженер всегда получают свои.
model NotificationPreference {
  userId  String
  type    String
  enabled Boolean @default(true)

  @@id([userId, type])
}

// UI-предпочтения (§7): вид разделов (канбан/таблица) и пр., per user.
model UserPreference {
  userId String
  key    String
  value  String

  @@id([userId, key])
}

// ─── Плагинное ядро (§14) ────────────────────────────────────────────────────

// Установленный модуль. Строка синхронизируется с манифестом пакета
// packages/plugins/<id> при старте приложения; enabled переключается из UI.
model Plugin {
  id          String          @id // = id из манифеста, напр. "demo"
  name        String
  version     String
  apiVersion  Int
  description String?
  permissions String[] // запрошенные права из манифеста
  enabled     Boolean         @default(false)
  installedAt DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  settings    PluginSetting[]
  runLogs     PluginRunLog[]
  apiTokens   ApiToken[]
}

// Настройки модуля (key-value, значения по settingsSchema манифеста).
model PluginSetting {
  pluginId String
  key      String
  value    Json
  plugin   Plugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@id([pluginId, key])
}

// Журнал запусков плагина: вызовы хуков, команд, рендеры слотов, обращения к API.
model PluginRunLog {
  id         String   @id @default(cuid())
  pluginId   String
  kind       String // hook | command | slot | api
  ref        String? // имя команды/хука/слота
  status     String // ok | error
  message    String?
  durationMs Int?
  createdAt  DateTime @default(now())
  plugin     Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@index([pluginId, createdAt])
}

// Шина доменных событий — outbox. Писатели добавляют запись в той же
// транзакции, что и изменение данных; диспетчер разносит по подписчикам.
model DomainEvent {
  id          String    @id @default(cuid())
  type        String // "project.created", "task.statusChanged", "plugin.toggled", ...
  payload     Json
  actor       String    @default("system") // userId | plugin:<id> | system
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@index([processedAt, createdAt])
}

// Токены публичного REST API (/api/v1) — для плагинов и внешних интеграций.
model ApiToken {
  id          String    @id @default(cuid())
  name        String
  prefix      String // первые символы токена — для отображения в UI
  tokenHash   String    @unique // sha256 от токена
  scopes      String[] // "read", "write", "plugins:manage", ...
  pluginId    String?
  plugin      Plugin?   @relation(fields: [pluginId], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
}

// Журнал изменений (§5): каждый чих в CRM.
model ChangeLog {
  id        String   @id @default(cuid())
  actorType String // user | plugin | system
  actorId   String // userId | plugin:<id> | system
  actorName String? // отображаемое имя на момент записи
  entity    String // plugin, priceItem, task, ...
  entityId  String
  action    String // create | update | delete | toggle | command | ...
  field     String? // изменённое поле (для update)
  oldValue  Json?
  newValue  Json?
  source    String   @default("web") // web | telegram | plugin | api
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([createdAt])
}
