// PERO CRM v2 — схема данных (Фаза 1: каркас)
// Полная доменная модель — см. §8 плана, добавляется в следующих фазах.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DIRECTOR
  MANAGER
  ENGINEER
  WORKER
  MOUNTER
  ACCOUNTANT
  PROCUREMENT
}

enum PayScheme {
  PIECE
  PERCENT_PROJECT
  PERCENT_TURNOVER
  NONE
}

enum ProductPayStage {
  ENGINEERING
  ASSEMBLY
  INSTALLATION
}

enum ProductPercentageKind {
  ENGINEERING
  ASSEMBLY
  INSTALLATION
}

enum ProductPercentageCompletionState {
  SKIPPED_ONCE
  PENDING_FX
  SETTLED
  LEGACY_PROTECTED
}

enum ProductStagePayState {
  DRAFT
  SETTLED
  LEGACY_PROTECTED
}

enum WorkPaymentKind {
  LEGACY
  ENGINEERING
  INSTALLATION
}

enum TaskAllocationBudgetSource {
  TASK_FIXED
  STAGE_PREVIEW
  PHYSICAL_ONLY
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  name            String // ФИО
  position        String? // должность (столяр, монтажник, менеджер проектов…)
  phone           String?
  telegram        String? // @username
  passwordHash    String
  sessionVersion  Int            @default(0)
  calendarEnabled Boolean?
  roles           Role[] // комбинированные роли (§4): права = объединение
  payScheme       PayScheme      @default(NONE)
  payPercent      Decimal?       @db.Decimal(5, 2)
  active          Boolean        @default(true)
  legacyId        String?
  legacyTable     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  managedProjects Project[]      @relation("ProjectManager")
  engineeredProducts Product[]   @relation("ProductEngineer")
  mountedProducts Product[]      @relation("ProductMounter")
  assembledProducts Product[] @relation("ProductAssembler")
  surveyedProducts Product[]    @relation("ProductSurveyor")
  assignedTasks   Task[]         @relation("TaskAssignee")
  calendarEntries CalendarEntry[]
  notifications   Notification[]
  payrollEntries  PayrollEntry[]
  payouts         Payout[]
  telegramLink    TelegramLink?
  createdStagePayPools ProductStagePayPool[] @relation("StagePayPoolCreator")
  convertedWorkPayments WorkPaymentConversion[] @relation("WorkPaymentConverter")
  closedStageSettlements ProductStageSettlement[] @relation("StageSettlementCloser")
  primaryStageSettlements ProductStageSettlement[] @relation("StageSettlementPrimaryEngineer")
  stageSettlementShares ProductStageSettlementShare[] @relation("StageSettlementShareUser")
  percentageParticipants ProductPercentageParticipant[]
  percentageCompletionShares ProductPercentageCompletionShare[]
  percentageCompletions ProductPercentageCompletion[] @relation("PercentageCompletionRecipient")
}

// ─── Проекты и клиенты (фаза 2, §6) ──────────────────────────────────────────

enum ProjectStage {
  LEAD // Лид
  ESTIMATE // Просчёт
  CONTRACT // Договор
  IN_WORK // В работе
  DONE // Завершён
  REFUSED // Отказ
  PAUSED // Пауза
  RECLAMATION // Рекламация
}

enum TaskStatus {
  DRAFT // Черновик (без исполнителя)
  NEW // Новая
  IN_PROGRESS // В работе
  DONE // Выполнена
}

enum FileCategory {
  PHOTO // фото
  DRAWING // чертёж
  QUOTE // КП
  MEASUREMENT // замер
  DOCUMENT // документ
  OTHER // прочее
}

// Группа файла по этапу мебельного производства (§ плагин file-stages):
// Производство / Сборка / Монтаж.
enum FileStage {
  PRODUCTION // Производство
  ASSEMBLY // Сборка
  INSTALLATION // Монтаж
}

enum CommunicationType {
  CALL // звонок
  EMAIL // письмо
  MESSENGER // мессенджер
  MEETING // встреча
  NOTE // заметка
}

model Client {
  id             String          @id @default(cuid())
  name           String // Имя (или название для юрлица, напр. «ООО Альфа»)
  lastName       String? // Фамилия
  middleName     String? // Отчество
  phone          String
  email          String?
  address        String?
  comment        String?
  legacyId       String?
  legacyTable    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  projects       Project[]
  communications Communication[]
}

// Проект = заказ клиента (может включать десятки изделий, напр. ремонт
// целого дома). Этапы воронки — на проекте (§6); платежи, маржа и
// экономика — тоже на проекте (§11). Стоимость проекта = Σ цен изделий.
model Project {
  deletedAt DateTime?
  deletedById String? // actor snapshot; no cascade or reassignment
  id                     String       @id @default(cuid())
  number                 String       @unique // «205» — канонический номер, только цифры без ведущих нулей
  // Числовое представление номера для серверной сортировки «новые сверху»
  // (numberInt DESC) — заполняется при создании и миграцией нормализации
  numberInt              Int
  title                  String // название заказа
  stage                  ProjectStage @default(LEAD)
  stageChangedAt         DateTime     @default(now())
  currency               String       @default("BYN") // валюта проекта и его изделий
  // Первоначальная цена — первая цена КП клиенту (§11). Правят менеджмент
  // и telegram-бот; бэкфилл при внедрении — из Σ initialPrice изделий.
  initialPrice           Decimal?     @db.Decimal(12, 2)
  // Доставка / Выгрузка / Монтаж из КП — прибавляются к Σ цен изделий
  // в «сумме проекта» (карточка, канбан, экономика, бот). Не входят в базу
  // «% инженеру» при «В работе».
  delivery               Decimal?     @db.Decimal(12, 2)
  unloading              Decimal?     @db.Decimal(12, 2)
  installation           Decimal?     @db.Decimal(12, 2)
  address                String?
  refusalReason          String?
  refusalComment         String?
  reclamationReason      String?
  reclamationDescription String?
  reclamationFault       String?
  managerId              String?
  manager                User?        @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  clientId               String
  client                 Client       @relation(fields: [clientId], references: [id])
  createdById            String?
  legacyId               String?
  legacyTable            String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  products               Product[]
  stageHistory           ProjectStageHistory[]
  tasks                  Task[]
  works                  Work[]
  files                  File[]
  coverFileId            String? @unique
  coverFile              File? @relation("ProjectCover", fields: [coverFileId], references: [id], onDelete: SetNull)
  communications         Communication[]
  payments               Payment[]
  stageSettlements       ProductStageSettlement[]
  legacyProtectedStagePools ProductStagePayPool[] @relation("StagePayPoolLegacyProject")

  @@index([stage, stageChangedAt])
  @@index([numberInt])
}

// Статусы изделия — проще этапов проекта: производственная цепочка
// от проектирования до готовности + служебная «Рекламация».
enum ProductStatus {
  DESIGN // Проектирование
  PRODUCTION // В производстве
  DELIVERY // Доставка
  INSTALLATION // Установка
  DONE // Готово
  RECLAMATION // Рекламация
}

// Изделие — единица производства внутри проекта (бывшая сущность
// «Проект» до рефактора). Цена — на изделии (в валюте проекта);
// задачи/работы и потребность в материалах привязаны к изделию.
// Данные клиента (ФИО, адрес, телефон) подтягиваются из проекта —
// на уровне проекта они и вносятся.
model Product {
  deletedAt DateTime?
  deletedById String? // actor snapshot; no cascade or reassignment
  id               String       @id @default(cuid())
  projectId        String
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number           String       @unique // «205.21» / «205-1» — <номер проекта><разделитель><суффикс>
  // Числовой суффикс после префикса проекта («205.21» → 21, «205-3» → 3,
  // «108.» без суффикса → NULL) — для серверной сортировки внутри проекта
  suffixInt        Int?
  title            String // название изделия
  quantity         Int          @default(1) // одинаковых экземпляров в карточке
  kind             String? // вид изделия (текстовое поле, из legacy f2641)
  status           ProductStatus @default(DESIGN)
  statusChangedAt  DateTime     @default(now())
  expectedPrice    Decimal?     @db.Decimal(12, 2)
  initialPrice     Decimal?     @db.Decimal(12, 2) // первоначальная цена (сумма по проекту = Σ изделий)
  initialPriceCaptureEligible Boolean @default(false) // только новые изделия до первой явной цены
  description      String? // тех. описание (большое текстовое поле, правит и инженер, §4)
  // Инженер-проектировщик изделия: ответственен за конкретное изделие
  // (на проекте может быть несколько инженеров — по одному на изделие).
  // На него начисляется % от стоимости его изделий при переходе проекта
  // «В работе» (§10)
  assemblerId      String?
  assembler        User? @relation("ProductAssembler", fields: [assemblerId], references: [id], onDelete: SetNull)
  engineerId       String?
  engineer         User?        @relation("ProductEngineer", fields: [engineerId], references: [id], onDelete: SetNull)
  mounterId        String?
  mounter          User?        @relation("ProductMounter", fields: [mounterId], references: [id], onDelete: SetNull)
  noModel          Boolean      @default(false)
  surveyorId       String? // замерщик — сотрудник, произведший замер (legacy f4061)
  surveyor         User?        @relation("ProductSurveyor", fields: [surveyorId], references: [id], onDelete: SetNull)
  sketchFileId     String? @unique // эскиз изделия — изображение (показ в детальном просмотре)
  sketchFile       File?        @relation("ProductSketch", fields: [sketchFileId], references: [id], onDelete: SetNull)
  createdById      String?
  legacyId         String?
  legacyTable      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  statusHistory    ProductStatusHistory[]
  tasks            Task[]
  works            Work[]
  files            File[]
  projectMaterials ProjectMaterial[]
  stockMovements   StockMovement[]
  stagePayPools    ProductStagePayPool[]
  stageSettlements ProductStageSettlement[] @relation("ProductStageSettlementProduct")
  payrollEntries   PayrollEntry[]
  percentageConfigs ProductPercentageConfig[]
  percentageCompletions ProductPercentageCompletion[]

  @@index([projectId])
  @@index([projectId, suffixInt])
  @@index([status, statusChangedAt])
  @@index([engineerId])
  @@index([mounterId])
  @@index([assemblerId])
}

model ProductStatusHistory {
  id          String        @id @default(cuid())
  productId   String
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromStatus  ProductStatus?
  toStatus    ProductStatus
  comment     String?
  changedById String?
  createdAt   DateTime      @default(now())

  @@index([productId, createdAt])
}

model ProjectStageHistory {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStage   ProjectStage?
  toStage     ProjectStage
  comment     String?
  changedById String?
  createdAt   DateTime     @default(now())

  @@index([projectId, createdAt])
}

// Задача (§9): статусы Черновик → Новая → В работе → Выполнена;
// зависимости DAG; оценка времени из истории + факт из TimeEntry.
// Привязка: всегда к проекту, опционально — к конкретному изделию.
model Task {
  id             String     @id @default(cuid())
  projectId      String
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  title          String
  type           String? // "Замер" и др.; шаблоны — плагин Базиса
  status         TaskStatus @default(NEW)
  assigneeId     String?
  assignee       User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  workId         String?
  work           Work?      @relation(fields: [workId], references: [id], onDelete: SetNull)
  quantity       Decimal?   @db.Decimal(10, 2) // часть количества работы (работу можно делить между задачами)
  dueAt          DateTime?
  requiresPhoto  Boolean    @default(false) // при выполнении просим приложить файлы (§6.2)
  estimateMinutes Int? // оценка (среднее идентичных из истории / шаблон), правит менеджер
  executorShare  Decimal    @default(1) @db.Decimal(4, 3) // доля исполнителя в оплате работы
  allocationGroupId String?
  allocationGroup TaskAllocationGroup? @relation(fields: [allocationGroupId], references: [id], onDelete: Restrict)
  shareUnits     Int? // 1 000 000 единиц = 100% исходной группы
  shareAmount    Decimal? @db.Decimal(12, 2) // точный бюджет этой части, не умножать повторно на долю
  physicalOnlyShare Boolean @default(false) // физическое деление монтажной работы без денежной доли задачи
  stageShareUnits Int? // доля процентного пула изделия; отдельна от физического объёма и shareAmount
  splitRevision  Int @default(0) // оптимистическая ревизия формы деления
  doneAt         DateTime?
  doneById       String?
  createdById    String?
  legacyId       String?
  legacyTable    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  files          File[]
  timeEntries    TimeEntry[]
  dependencies   TaskDependency[]  @relation("TaskDependencies")
  dependents     TaskDependency[]  @relation("TaskDependents")
  payrollEntries PayrollEntry[]
  stageSettlementShares ProductStageSettlementShare[]

  @@index([assigneeId, status])
  @@index([productId])
  @@index([allocationGroupId])
  @@index([workId])
}

// Группа возникает только при первом делении незавершённой задачи.
// Исходное количество Work учитывается один раз; прежние задачи/начисления не backfill-ятся.
model TaskAllocationGroup {
  id          String @id @default(cuid())
  workId      String?
  work        Work? @relation(fields: [workId], references: [id], onDelete: SetNull)
  quantity    Decimal? @db.Decimal(10, 2)
  budget      Decimal? @db.Decimal(12, 2)
  budgetSource TaskAllocationBudgetSource @default(TASK_FIXED)
  currency    String?
  createdById String
  createdAt   DateTime @default(now())
  tasks       Task[]

  @@index([workId])
}

// Зависимость задач (DAG, §9): задача блокируется,
// пока предшественники не выполнены.
model TaskDependency {
  taskId      String
  task        Task   @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   Task   @relation("TaskDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
}

// ─── Прайсы и работы (§9) ────────────────────────────────────────────────────

// Расценка из прайса. Изменения — в журнал (§5); цена фиксируется
// в работе на момент назначения (смена прайса не переписывает прошлое).
model PriceItem {
  id          String   @id @default(cuid())
  name        String
  unit        String // шт / м² / м.п. / компл / час
  price       Decimal  @db.Decimal(12, 2)
  category    String?
  active      Boolean  @default(true)
  legacyId    String?
  legacyTable String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  works       Work[]
}

// Работа: расценка × количество, цена — снимок на момент назначения.
// Привязка: всегда к проекту, опционально — к конкретному изделию.
model Work {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  priceItemId   String?
  priceItem     PriceItem? @relation(fields: [priceItemId], references: [id], onDelete: SetNull)
  title         String
  quantity      Decimal   @db.Decimal(10, 2)
  quantityPerUnit Decimal? @db.Decimal(10, 2) // норма на одно изделие; quantity — на партию
  priceSnapshot Decimal?  @db.Decimal(12, 2) // цена на момент назначения
  total         Decimal?  @db.Decimal(12, 2) // priceSnapshot × quantity
  paymentKind   WorkPaymentKind @default(LEGACY)
  stagePayPoolId String?
  stagePayPool ProductStagePayPool? @relation(fields: [stagePayPoolId], references: [id], onDelete: Restrict)
  poolWeightUnits Int?
  createdById   String?
  legacyId      String?
  legacyTable   String?
  createdAt     DateTime  @default(now())
  tasks         Task[]
  allocationGroups TaskAllocationGroup[]
  paymentConversions WorkPaymentConversion[]
  settlementShares ProductStageSettlementShare[]

  @@index([projectId])
  @@index([productId])
  @@index([stagePayPoolId])
}

// ─── Время по задачам (§9) ───────────────────────────────────────────────────

// Запись времени: таймер (старт-стоп на сервере, переживает перезаход)
// или ручной ввод. spentMinutes задачи = сумма minutes.
model TimeEntry {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  source      String // timer | manual
  startedAt   DateTime  @default(now())
  stoppedAt   DateTime?
  minutes     Int       @default(0)
  autoStopped Boolean   @default(false) // автостоп по таймауту 12 ч (§19)
  createdAt   DateTime  @default(now())

  @@index([userId, stoppedAt])
  @@index([taskId])
}

// ─── Начисления и выплаты (§10) ──────────────────────────────────────────────

// Начисление оплаты. Сдельно: расценка × количество × доля исполнителя,
// возникает при переходе задачи в «Выполнена». % от стоимости (инженер) —
// при переходе проекта «В работе». % от оборота — при закрытии месяца.
model PayrollEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  workId     String?
  productId String?
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  settlementShareId String? @unique
  settlementShare ProductStageSettlementShare? @relation(fields: [settlementShareId], references: [id], onDelete: Restrict)
  percentageCompletionShareId String? @unique
  percentageCompletionShare ProductPercentageCompletionShare? @relation(fields: [percentageCompletionShareId], references: [id], onDelete: Restrict)
  bynAmount Decimal? @db.Decimal(18, 2)
  projectAmount Decimal? @db.Decimal(12, 2)
  projectCurrency String?
  // Проект необязателен: начисление «% от оборота» — на организацию целиком
  projectId  String?
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @default("BYN")
  scheme     String   @default("PIECE") // PIECE | PERCENT_PROJECT | PERCENT_TURNOVER
  month      String // YYYY-MM расчётного месяца
  comment    String?
  createdAt  DateTime @default(now())

  @@index([userId, month])
  @@index([projectId])
  @@index([productId])
}

// Новые прямые проценты. Старые Work/Task/settlement записи остаются нетронутыми.
model ProductPercentageConfig {
  id          String                @id @default(cuid())
  productId   String
  product     Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  kind        ProductPercentageKind
  ratePercent Decimal?              @db.Decimal(5, 2)
  revision    Int                   @default(0)
  reviewedLegacyWorkIds String[]    @default([])
  workReview Json?
  participants ProductPercentageParticipant[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([productId, kind])
}

model ProductPercentageParticipant {
  id         String                  @id @default(cuid())
  configId   String
  config     ProductPercentageConfig @relation(fields: [configId], references: [id], onDelete: Restrict)
  userId     String
  user       User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  shareUnits Int

  @@unique([configId, userId])
  @@index([userId])
}

// Один снимок первого завершения этапа; замороженные входы остаются при FX retry.
model ProductPercentageCompletion {
  id             String                           @id @default(cuid())
  productId      String
  product        Product                          @relation(fields: [productId], references: [id], onDelete: Restrict)
  kind           ProductPercentageKind
  state          ProductPercentageCompletionState
  completedAt    DateTime                         @default(now())
  completedById  String?
  statusAtCompletion ProductStatus
  reason         String?
  calculationVersion Int                         @default(1)
  quantitySnapshot Int?
  totalSnapshot Decimal?                         @db.Decimal(18, 2)
  recipientId String?
  recipient User? @relation("PercentageCompletionRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  priceSnapshot  Decimal?                         @db.Decimal(12, 2)
  ratePercentSnapshot Decimal?                    @db.Decimal(5, 2)
  productCurrency String
  payrollCurrency String?
  configRevision Int?
  productRateByn Decimal?                        @db.Decimal(18, 6)
  payrollRateByn Decimal?                        @db.Decimal(18, 6)
  productRateDate DateTime?                      @db.Date
  payrollRateDate DateTime?                      @db.Date
  sourceFundExact Decimal?                      @db.Decimal(18, 6)
  amount         Decimal?                        @db.Decimal(12, 2)
  bynAmount      Decimal?                        @db.Decimal(18, 2)
  projectAmount  Decimal?                        @db.Decimal(12, 2)
  settledAt      DateTime?
  shares         ProductPercentageCompletionShare[]

  @@unique([productId, kind])
  @@index([state])
}

model ProductPercentageCompletionShare {
  id            String                       @id @default(cuid())
  completionId  String
  completion    ProductPercentageCompletion  @relation(fields: [completionId], references: [id], onDelete: Restrict)
  userId        String
  user          User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  userNameSnapshot String
  shareUnits    Int
  amount        Decimal?                     @db.Decimal(12, 2)
  bynAmount     Decimal?                     @db.Decimal(18, 2)
  projectAmount Decimal?                     @db.Decimal(12, 2)
  payrollEntry  PayrollEntry?

  @@unique([completionId, userId])
}

// Неизменяемый снимок пула оплаты изделия для производственного этапа.
model ProductStagePayPool {
  id                    String              @id @default(cuid())
  productId             String
  product               Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  kind                  ProductPayStage
  state                 ProductStagePayState @default(DRAFT)
  ratePercent           Decimal?            @db.Decimal(5, 2)
  revision              Int                 @default(0)
  legacyProjectId       String?
  legacyProject         Project?            @relation("StagePayPoolLegacyProject", fields: [legacyProjectId], references: [id], onDelete: Restrict)
  legacyPayrollEntryIds String[]             @default([])
  legacyProtectedAt     DateTime?            @db.Timestamp(3)
  createdById           String?
  createdBy             User?               @relation("StagePayPoolCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  works                 Work[]
  conversions           WorkPaymentConversion[]
  settlement            ProductStageSettlement?

  @@unique([productId, kind])
  @@index([state, kind])
}

model WorkPaymentConversion {
  id                 String   @id @default(cuid())
  workId             String   @unique
  work               Work     @relation(fields: [workId], references: [id], onDelete: Restrict)
  poolId             String
  pool               ProductStagePayPool @relation(fields: [poolId], references: [id], onDelete: Restrict)
  requestId          String   @unique
  requestFingerprint String
  convertedById      String
  convertedBy        User     @relation("WorkPaymentConverter", fields: [convertedById], references: [id], onDelete: Restrict)
  convertedAt        DateTime @db.Timestamp(3)
  sourceSnapshot     Json
  targetShares       Json

}

model ProductStageSettlement {
  id                         String   @id @default(cuid())
  poolId                     String   @unique
  pool                       ProductStagePayPool @relation(fields: [poolId], references: [id], onDelete: Restrict)
  productId                  String
  product                    Product  @relation("ProductStageSettlementProduct", fields: [productId], references: [id], onDelete: Restrict)
  projectId                  String
  project                    Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  closedById                 String
  closedBy                   User     @relation("StageSettlementCloser", fields: [closedById], references: [id], onDelete: Restrict)
  closedAt                   DateTime @db.Timestamp(3)
  poolRevision               Int
  primaryEngineerIdSnapshot  String
  primaryEngineer            User     @relation("StageSettlementPrimaryEngineer", fields: [primaryEngineerIdSnapshot], references: [id], onDelete: Restrict)
  primaryEngineerNameSnapshot String
  priceSnapshot              Decimal  @db.Decimal(12, 2)
  ratePercentSnapshot        Decimal  @db.Decimal(5, 2)
  productCurrency            String
  payrollCurrency            String
  productRateByn             Decimal  @db.Decimal(18, 6)
  payrollRateByn             Decimal  @db.Decimal(18, 6)
  productRateDate            DateTime @db.Date
  payrollRateDate            DateTime @db.Date
  sourceFundExact            Decimal  @db.Decimal(18, 6)
  amount                     Decimal  @db.Decimal(12, 2)
  bynAmount                  Decimal  @db.Decimal(18, 2)
  projectAmount              Decimal  @db.Decimal(12, 2)
  shares                     ProductStageSettlementShare[]

  @@index([projectId])
  @@index([productId])
}

model ProductStageSettlementShare {
  id                          String   @id @default(cuid())
  settlementId                String
  settlement                  ProductStageSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  taskId                      String
  task                        Task     @relation(fields: [taskId], references: [id], onDelete: Restrict)
  workId                      String
  work                        Work     @relation(fields: [workId], references: [id], onDelete: Restrict)
  userId                      String
  user                        User     @relation("StageSettlementShareUser", fields: [userId], references: [id], onDelete: Restrict)
  taskTitleSnapshot           String
  workTitleSnapshot           String
  userNameSnapshot            String
  workWeightUnits             Int
  stageShareUnits             Int
  quantitySnapshot            Decimal? @db.Decimal(10, 2)
  quantityShareUnitsSnapshot  Int
  allocationGroupIdSnapshot   String?
  amount                      Decimal  @db.Decimal(12, 2)
  bynAmount                   Decimal  @db.Decimal(18, 2)
  projectAmount               Decimal  @db.Decimal(12, 2)
  payrollEntry                PayrollEntry?

  @@unique([settlementId, taskId])
  @@index([workId])
  @@index([userId])
}

// Выплата зарплаты (§10): вносит администратор, история по месяцам.
// month — расчётный месяц, к которому относится выплата.
// kind: SALARY — обычная выплата по долгу за прошлые месяцы,
// ADVANCE — аванс текущим месяцем (потолок — только баланс организации;
// учитывается формулой долга автоматически: долг = начислено − ВСЕ выплаты).
model Payout {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2)
  month       String // YYYY-MM расчётного месяца
  kind        String   @default("SALARY") // SALARY | ADVANCE
  comment     String?
  createdById String?
  createdAt   DateTime @default(now())
  cashAccountId String?
  cashAccount   CashAccount? @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  cashAmount    Decimal? @db.Decimal(12, 2)
  cashCurrency  String?
  bynAmount     Decimal? @db.Decimal(18, 2)
  cashRate      Decimal? @db.Decimal(14, 6)
  payrollRate   Decimal? @db.Decimal(14, 6)
  cashRateDate    DateTime? @db.Date
  payrollRateDate DateTime? @db.Date
  payrollCurrency String?

  @@index([userId, month])
  @@index([month])
  @@index([cashAccountId])
}

// Направление платежа (§11): приход от клиента / расход на проект
// (материалы, прочее — уменьшают маржу, см. экономику проекта).
enum PaymentDirection {
  INCOME
  EXPENSE
}

// Касса организации (§11): каждая в своей валюте. Баланс = сумма своих
// операций (приходы − расходы); операция проводится по кассе только
// в валюте кассы (конвертация фиксируется курсом в самой операции).
model CashAccount {
  id        String    @id @default(cuid())
  name      String
  currency  String    @default("BYN")
  comment   String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments  Payment[]
  payouts   Payout[]
}

// Статья расходов (§8): справочник для расходов по проектам
// (Материалы, Логистика, Прочее…). ЗП в статьях нет — она считается
// из PayrollEntry (§10).
model ExpenseArticle {
  id        String    @id @default(cuid())
  code      Int       @unique
  name      String
  comment   String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments  Payment[]
}

// Платёж по проекту (§11): приход или расход в любой из 4 валют.
// Курс подтягивается с НБ РБ в момент внесения и СОХРАНЯЕТСЯ в записи
// (курс, дата курса, эквиваленты) — отдельного кэша курсов нет,
// историчность обеспечивается самими записями. Курс можно поправить вручную.
//   rate — BYN за 1 единицу валюты операции (как на сайте НБ РБ; 1 для BYN);
//   bynAmount — эквивалент в BYN (оборот для «% от оборота», баланс орг.);
//   projectAmount — эквивалент в валюте проекта (экономика проекта, маржа).
model Payment {
  id               String           @id @default(cuid())
  projectId        String?
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  direction        PaymentDirection @default(INCOME)
  amount           Decimal          @db.Decimal(12, 2) // в валюте операции
  currency         String           @default("BYN")
  rate             Decimal          @default(1) @db.Decimal(14, 6) // BYN за ед. валюты (НБ РБ)
  rateDate         DateTime? // дата курса НБ РБ
  bynAmount        Decimal          @db.Decimal(12, 2) // эквивалент в BYN
  projectAmount    Decimal?         @db.Decimal(12, 2) // эквивалент в валюте проекта
  cashAccountId    String?
  cashAccount      CashAccount?     @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)
  expenseArticleId String?
  expenseArticle   ExpenseArticle?  @relation(fields: [expenseArticleId], references: [id], onDelete: SetNull)
  paidAt           DateTime         @default(now())
  comment          String?
  createdById      String?
  createdAt        DateTime         @default(now())

  @@index([projectId])
  @@index([paidAt])
  @@index([cashAccountId])
}

// Настройки организации (§10): key-value, сейчас — payrollCurrency
// (единая валюта зарплаты, по умолчанию BYN; задаёт администратор).
model OrgSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Склад (§12, фаза 6) ────────────────────────────────────────────────
// Остатки не хранятся — вычисляются из StockMovement
// (остаток = Σ INCOME + Σ RETURN − Σ EXPENSE).

// Тип движения по складу: приход на склад / списание на проект /
// возврат с проекта обратно на склад.
enum StockMovementType {
  INCOME
  EXPENSE
  RETURN
}

// Категория номенклатуры (аналог legacy 1411 «Номенклатурные группы», плоско).
model MaterialCategory {
  id        String     @id @default(cuid())
  name      String
  comment   String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  materials Material[]
}

// Номенклатура (аналог legacy 1441 «Склад номенклатуры», MVP-набор полей).
// purchasePrice — учётная цена в BYN: подставляется в списание как снимок
// (в диалоге её можно поправить на конкретное движение).
model Material {
  id               String            @id @default(cuid())
  name             String
  sku              String? // артикул
  unit             String            @default("шт") // из MATERIAL_UNITS (src/lib/labels.ts)
  categoryId       String?
  category         MaterialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  purchasePrice    Decimal?          @db.Decimal(12, 2) // учётная цена, BYN
  minStock         Decimal?          @db.Decimal(12, 3) // подсветка низкого остатка
  active           Boolean           @default(true)
  comment          String?
  legacyId         String?
  legacyTable      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  movements        StockMovement[]
  projectMaterials ProjectMaterial[]
}

// Потребность изделия в материале (аналог legacy 1531 «Номенклатура в заказах»).
// Она же — простой резерв (§12): количество фиксируется за изделием
// БЕЗ проверки остатка (строки в будущем создаёт скриптом плагин
// «Базис-Мебельщик»). Нехватка вычисляется: debt = quantity − issuedQty,
// строка «в нехватке», если debt > 0 и остаток на складе < debt.
model ProjectMaterial {
  id          String          @id @default(cuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId  String
  material    Material        @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantity    Decimal         @db.Decimal(12, 3) // сколько нужно на партию
  quantityPerUnit Decimal?    @db.Decimal(12, 3) // норма на одно изделие
  issuedQty   Decimal         @default(0) @db.Decimal(12, 3) // сколько уже выдано со склада
  comment     String?
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  movements   StockMovement[]

  @@unique([productId, materialId]) // повторное добавление того же материала наращивает quantity
  @@index([materialId])
}

// Единый журнал движений (аналог legacy 1641 «Учёт движения»).
// EXPENSE/RETURN — всегда с изделием и ценой: totalByn идёт в экономику
// проекта (getProjectEconomics, строка «Материалы (склад)» в расходах)
// через изделия этого проекта.
model StockMovement {
  id                String            @id @default(cuid())
  materialId        String
  material          Material          @relation(fields: [materialId], references: [id], onDelete: Restrict)
  type              StockMovementType
  quantity          Decimal           @db.Decimal(12, 3)
  unitPrice         Decimal?          @db.Decimal(12, 2) // BYN/ед., снимок (обязателен для EXPENSE/RETURN)
  totalByn          Decimal?          @db.Decimal(12, 2) // quantity × unitPrice, снимок
  productId         String?
  product           Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  projectMaterialId String?
  projectMaterial   ProjectMaterial?  @relation(fields: [projectMaterialId], references: [id], onDelete: SetNull)
  comment           String?
  createdById       String?
  createdAt         DateTime          @default(now())

  @@index([materialId])
  @@index([productId])
  @@index([createdAt])
}

model File {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  taskId       String?
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  category     FileCategory @default(OTHER)
  stage        FileStage    @default(PRODUCTION) // группа этапа (file-stages)
  caption      String? // пояснение
  fileName     String // оригинальное имя
  storedName   String // имя на диске
  mimeType     String
  size         Int
  hasThumb     Boolean      @default(false)
  uploadedById String?
  legacyId     String?
  legacyTable  String?
  createdAt    DateTime     @default(now())
  sketchForProduct Product?  @relation("ProductSketch")
  coverForProject Project? @relation("ProjectCover")

  @@index([projectId, category])
  @@index([projectId, stage])
}

model Communication {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  type        CommunicationType
  text        String
  happenedAt  DateTime          @default(now())
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([projectId, happenedAt])
}

// ─── Уведомления (§6.1) ──────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // project.created, project.stageChanged, task.assigned, ...
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// Настройка типов уведомлений — только админ/директор/менеджер (§6.1);
// работник/монтажник/инженер всегда получают свои.
model NotificationPreference {
  userId  String
  type    String
  enabled Boolean @default(true)

  @@id([userId, type])
}

// UI-предпочтения (§7): вид разделов (канбан/таблица) и пр., per user.
model UserPreference {
  userId String
  key    String
  value  String

  @@id([userId, key])
}

// ─── Плагинное ядро (§14) ────────────────────────────────────────────────────

// Установленный модуль. Строка синхронизируется с манифестом пакета
// packages/plugins/<id> при старте приложения; enabled переключается из UI.
model Plugin {
  id          String          @id // = id из манифеста, напр. "demo"
  name        String
  version     String
  apiVersion  Int
  description String?
  permissions String[] // запрошенные права из манифеста
  enabled     Boolean         @default(false)
  installedAt DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  settings    PluginSetting[]
  runLogs     PluginRunLog[]
  apiTokens   ApiToken[]
}

// Настройки модуля (key-value, значения по settingsSchema манифеста).
model PluginSetting {
  pluginId String
  key      String
  value    Json
  plugin   Plugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@id([pluginId, key])
}

// Журнал запусков плагина: вызовы хуков, команд, рендеры слотов, обращения к API.
model PluginRunLog {
  id         String   @id @default(cuid())
  pluginId   String
  kind       String // hook | command | slot | api
  ref        String? // имя команды/хука/слота
  status     String // ok | error
  message    String?
  durationMs Int?
  createdAt  DateTime @default(now())
  plugin     Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@index([pluginId, createdAt])
}

// Шина доменных событий — outbox. Писатели добавляют запись в той же
// транзакции, что и изменение данных; диспетчер разносит по подписчикам.
model DomainEvent {
  id          String    @id @default(cuid())
  type        String // "project.created", "task.statusChanged", "plugin.toggled", ...
  payload     Json
  actor       String    @default("system") // userId | plugin:<id> | system
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@index([processedAt, createdAt])
}

// Токены публичного REST API (/api/v1) — для плагинов и внешних интеграций.
model ApiToken {
  id          String    @id @default(cuid())
  name        String
  prefix      String // первые символы токена — для отображения в UI
  tokenHash   String    @unique // sha256 от токена
  scopes      String[] // "read", "write", "plugins:manage", ...
  pluginId    String?
  plugin      Plugin?   @relation(fields: [pluginId], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
}

// Журнал изменений (§5): каждый чих в CRM.
model ChangeLog {
  id        String   @id @default(cuid())
  actorType String // user | plugin | system
  actorId   String // userId | plugin:<id> | system
  actorName String? // отображаемое имя на момент записи
  entity    String // plugin, priceItem, task, ...
  entityId  String
  action    String // create | update | delete | toggle | command | ...
  field     String? // изменённое поле (для update)
  oldValue  Json?
  newValue  Json?
  source    String   @default("web") // web | telegram | plugin | api
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([createdAt])
}

// ─── Telegram-бот (сервис 09.2026, LXC tgbot) ────────────────────────────────

// Привязка Telegram-аккаунта к пользователю CRM. Одноразовый код выдаёт CRM
// из профиля (кнопка «Привязать Telegram»), chatId проставляет бот по
// /start <код>. Привязка доступна любой роли; использование бота — только
// ADMIN/DIRECTOR/MANAGER (решение владельца).
model TelegramLink {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId            String?   @unique // заполняет бот при /start <код>
  username          String? // @username в Telegram
  linkCode          String?   @unique // одноразовый код до подтверждения ботом
  linkCodeExpiresAt DateTime?
  linkedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Личный план: owner всегда текущий session actor.
enum CalendarEntryState {
  PLANNED
  COMPLETED
  CANCELLED
}
model CalendarEntry {
  id String @id
  ownerId String
  owner User @relation(fields:[ownerId],references:[id],onDelete:Restrict)
  title String @db.VarChar(250)
  description String @default("")
  startsAt DateTime @db.Timestamptz(3)
  state CalendarEntryState @default(PLANNED)
  reminderOffsetMinutes Int? @default(15)
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId,startsAt])
}